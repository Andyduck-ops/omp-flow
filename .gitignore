# Dependencies
node_modules/

# Build output
dist/

# Reference repositories (never commit or publish reference clones)
reference/

# Temporary test workspaces
.test-omp-flow-workspace/

# omp-flow runtime state (NOT committed; framework configs below are tracked)
.omp-flow/tasks/
.omp-flow/scratch/
.omp-flow/fsm/
.omp-flow/events/
.omp-flow/findings/
.omp-flow/sessions/
.omp-flow/issues/
.omp-flow/state.json
.omp-flow/.developer
.omp-flow/.runtime/
.omp-flow/.template-hashes.json
.omp-flow/.backup-*/
# `omp-flow dispose` quarantine. Load-bearing, not cosmetic: every rule above is
# root-anchored (a pattern containing a slash matches from this file's directory),
# so `.omp-flow/events/` does NOT match the quarantined copy at
# `.omp-flow/.quarantine/<stamp>/.omp-flow/events/...`. Without this rule the first
# disposal makes ~792 KB of ralph-era event data newly visible to `git status` and
# committable. This rule is what keeps the quarantine out of history.
.omp-flow/.quarantine/
.omp-flow/scripts/

# omp-flow framework configs (committed — workflow.md, config.json, specs, knowhow)
# These are NOT ignored; they are version-controlled like Trellis's .trellis/ configs.
# (Harness agent/skill definitions live under .omp/, .codex/ and .claude/, and the
# source templates under templates/ — neither set is inside .omp-flow/.)

# Python bytecode cache
__pycache__/
*.pyc

# Logs & temp files
*.log
npm-debug.log*
