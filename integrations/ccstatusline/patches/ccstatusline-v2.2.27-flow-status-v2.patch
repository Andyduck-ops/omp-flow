+import {
+    describe,
+    expect,
+    it
+} from 'vitest';
+
+import type {
+    FlowStatusFrameV2,
+    FlowStatusResultV2
+} from '../../providers/FlowStatusProvider';
+import type { RenderContext } from '../../types/RenderContext';
+import { DEFAULT_SETTINGS } from '../../types/Settings';
+import {
+    calculateMaxWidthsFromPreRendered,
+    preRenderAllWidgets,
+    renderStatusLine
+} from '../../utils/renderer';
+import { FlowStatusWidget } from '../FlowStatus';
+
+const VIEW: FlowStatusFrameV2 = {
+    state: 'available',
+    freshness: 'fresh',
+    ageMs: 1000,
+    snapshotRevision: 'snapshot-revision-0001',
+    rootTask: {
+        taskId: '07-30-omp-flow-tui-control',
+        title: 'TUI control'
+    },
+    orientation: {
+        index: 6,
+        position: 'execute',
+        label: 'Execute',
+        movement: 'same',
+        measure: {
+            owner: 'accepted-work',
+            label: 'Work',
+            current: 4,
+            total: 13,
+            unit: 'accepted'
+        },
+        detail: {
+            kind: 'execute',
+            currentWork: {
+                workId: 'claude-hook',
+                title: 'Claude Hook',
+                focus: 'review',
+                reviewRound: 2,
+                reworkRound: 1,
+                reviewVerdict: 'pending'
+            }
+        }
+    },
+    blockingAttention: 0
+};
+
+function widget(result: FlowStatusResultV2 = VIEW): FlowStatusWidget {
+    return new FlowStatusWidget({ read: () => result });
+}
+
+describe('FlowStatusWidget v2', () => {
+    it('renders the root Task full and compact forms', () => {
+        expect(widget().render(
+            { id: 'root', type: 'flow-status', view: 'root-task' },
+            { data: {}, terminalWidth: 80 },
+            DEFAULT_SETTINGS
+        )).toBe('Task · 07-30-omp-flow-tui-control · TUI control');
+        expect(widget().render(
+            { id: 'root', type: 'flow-status', view: 'root-task' },
+            { data: {}, terminalWidth: 24 },
+            DEFAULT_SETTINGS
+        )).toBe('Task · TUI control');
+    });
+
+    it('renders one labelled graphical measure and compacts it atomically', () => {
+        const full = widget().render(
+            { id: 'flow', type: 'flow-status', view: 'flow' },
+            { data: {}, terminalWidth: 100 },
+            DEFAULT_SETTINGS
+        );
+        expect(full).toBe('Flow 6/9 · Execute │ Work 4/13 ████░░░░░░░░░ │ Review · Round 2 · Claude Hook');
+        expect(full?.match(/[█░]+/gu)).toHaveLength(1);
+        expect(widget().render(
+            { id: 'flow', type: 'flow-status', view: 'flow' },
+            { data: {}, terminalWidth: 35 },
+            DEFAULT_SETTINGS
+        )).toBe('Flow 6/9 Execute | Work 4/13');
+    });
+
+    it('renders unavailable root truth without a second row or stray separators', () => {
+        const unavailable: FlowStatusResultV2 = {
+            state: 'unavailable',
+            reason: 'expired'
+        };
+        expect(widget(unavailable).render(
+            { id: 'root', type: 'flow-status', view: 'root-task' },
+            { data: {}, terminalWidth: 80 },
+            DEFAULT_SETTINGS
+        )).toBe('Task · unavailable');
+        expect(widget(unavailable).render(
+            { id: 'flow', type: 'flow-status', view: 'flow' },
+            { data: {}, terminalWidth: 80 },
+            DEFAULT_SETTINGS
+        )).toBeNull();
+    });
+
+    it('keeps Wave out and composes two views with native first-row widgets', () => {
+        const context: RenderContext = {
+            data: { model: 'Opus' },
+            terminalWidth: 100,
+            isPreview: true
+        };
+        const settings = {
+            ...DEFAULT_SETTINGS,
+            colorLevel: 0 as const,
+            powerline: { ...DEFAULT_SETTINGS.powerline, enabled: true },
+            lines: [
+                [
+                    { id: 'root', type: 'flow-status', view: 'root-task' as const },
+                    { id: 'model', type: 'model', rawValue: true }
+                ],
+                [{ id: 'flow', type: 'flow-status', view: 'flow' as const }]
+            ]
+        };
+        const rendered = preRenderAllWidgets(settings.lines, settings, context);
+        const widths = calculateMaxWidthsFromPreRendered(rendered, settings);
+        const first = renderStatusLine(
+            settings.lines[0] ?? [],
+            settings,
+            { ...context, lineIndex: 0 },
+            rendered[0] ?? [],
+            widths
+        );
+        const second = renderStatusLine(
+            settings.lines[1] ?? [],
+            settings,
+            { ...context, lineIndex: 1 },
+            rendered[1] ?? [],
+            widths
+        );
+        expect(first).toContain('Task');
+        expect(first).toContain('Claude');
+        expect(second).toContain('Flow 6/9');
+        expect(`${first}\n${second}`).not.toContain('Wave');
+    });
+});
