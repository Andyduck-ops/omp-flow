diff --git a/src/widgets/FlowStatus.ts b/src/widgets/FlowStatus.ts
new file mode 100644
index 0000000..4e90f25
--- /dev/null
+++ b/src/widgets/FlowStatus.ts
@@ -0,0 +1,244 @@
+import {
+    FlowStatusProvider,
+    type FlowStatusCurrentWorkV2,
+    type FlowStatusFrameV2,
+    type FlowStatusResultV2
+} from '../providers/FlowStatusProvider';
+import type { RenderContext } from '../types/RenderContext';
+import type { Settings } from '../types/Settings';
+import type {
+    Widget,
+    WidgetEditorDisplay,
+    WidgetItem
+} from '../types/Widget';
+import { getVisibleWidth } from '../utils/ansi';
+
+function view(item: WidgetItem): 'root-task' | 'flow' | null {
+    return item.view === 'root-task' || item.view === 'flow' ? item.view : null;
+}
+
+function ascii(context: RenderContext): boolean {
+    return process.env.NO_COLOR !== undefined
+        || !context.terminalWidth
+        || context.terminalWidth < 30;
+}
+
+function cropEnd(value: string, width: number): string {
+    if (getVisibleWidth(value) <= width)
+        return value;
+    let output = '';
+    for (const char of value) {
+        if (getVisibleWidth(`${output}${char}…`) > width)
+            break;
+        output += char;
+    }
+    return `${output}…`;
+}
+
+function middle(value: string, width: number): string {
+    if (getVisibleWidth(value) <= width)
+        return value;
+    const chars = Array.from(value);
+    let left = '';
+    let right = '';
+    let index = 0;
+    while (index < chars.length) {
+        const targetLeft = index % 2 === 0;
+        const char = targetLeft ? chars.shift() : chars.pop();
+        if (!char)
+            break;
+        const next = targetLeft ? `${left}${char}…${right}` : `${left}…${char}${right}`;
+        if (getVisibleWidth(next) > width)
+            break;
+        if (targetLeft)
+            left += char;
+        else
+            right = char + right;
+        index += 1;
+    }
+    return `${left}…${right}`;
+}
+
+function bar(current: number, total: number, useAscii: boolean): string {
+    const width = Math.min(13, Math.max(5, total));
+    const filled = Math.max(0, Math.min(width, Math.round(current / total * width)));
+    return useAscii
+        ? `[${'#'.repeat(filled)}${'-'.repeat(width - filled)}]`
+        : `${'█'.repeat(filled)}${'░'.repeat(width - filled)}`;
+}
+
+function rootTask(
+    result: FlowStatusResultV2,
+    terminalWidth: number
+): string | null {
+    if (terminalWidth < 6)
+        return null;
+    if (result.state === 'unavailable')
+        return terminalWidth < 18 ? 'Task ?' : 'Task · unavailable';
+    const { taskId, title } = result.rootTask;
+    const full = title ? `Task · ${taskId} · ${title}` : `Task · ${taskId}`;
+    if (getVisibleWidth(full) <= terminalWidth)
+        return full;
+    if (title) {
+        const friendly = `Task · ${title}`;
+        if (getVisibleWidth(friendly) <= terminalWidth)
+            return friendly;
+        return cropEnd(friendly, terminalWidth);
+    }
+    return `Task · ${middle(taskId, Math.max(1, terminalWidth - 7))}`;
+}
+
+function currentWork(detail: Record<string, unknown>, compact: boolean): string | null {
+    if (detail.kind !== 'execute' || detail.currentWork === null)
+        return null;
+    const current = detail.currentWork as FlowStatusCurrentWorkV2;
+    const title = current.title ?? current.workId;
+    if (compact) {
+        if (current.focus === 'review')
+            return `${title} · Review R${current.reviewRound}`;
+        if (current.focus === 'rework')
+            return `${title} · Rework R${current.reworkRound}`;
+        return `${title} · ${current.focus === 'implement' ? 'Implement' : 'Accepted'}`;
+    }
+    if (current.focus === 'review')
+        return `Review · Round ${current.reviewRound} · ${title}`;
+    if (current.focus === 'rework')
+        return `Rework ${current.reworkRound} · Review ${current.reviewRound} · ${title}`;
+    if (current.focus === 'implement')
+        return `Implement · ${title}`;
+    return `Accepted · ${title}`;
+}
+
+function phaseDetail(frame: FlowStatusFrameV2, compact: boolean): string | null {
+    const detail = frame.orientation.detail;
+    if (detail.kind === 'execute')
+        return currentWork(detail, compact);
+    if (detail.kind === 'explore')
+        return `${detail.mode === 'research' ? 'Research' : 'Brainstorm'} · ${compact ? 'R' : 'Round '}${String(detail.round)}`;
+    if (detail.kind === 'qbd-1' || detail.kind === 'qbd-2')
+        return `${compact ? 'A' : 'Attempt '}${String(detail.attempt)} · ${String(detail.verdict).toUpperCase()}`;
+    if (detail.kind === 'finish' && detail.focus === 'completion-audit' && detail.completionAudit) {
+        const audit = detail.completionAudit as Record<string, unknown>;
+        return `${compact ? 'Audit A' : 'Completion audit · Attempt '}${String(audit.attempt)}`;
+    }
+    if (typeof detail.focus === 'string')
+        return compact ? detail.focus : `${frame.orientation.label} · ${detail.focus}`;
+    return null;
+}
+
+function movement(frame: FlowStatusFrameV2): string | null {
+    const value = frame.orientation.movement;
+    if (value === 'same' || value === 'initial')
+        return null;
+    const labels: Record<string, string> = {
+        initial: '',
+        same: '',
+        forward: 'Forward',
+        backtrack: '↩ Backtrack',
+        resume: 'Resume',
+        reopen: '↩ Reopen'
+    };
+    return labels[value] ?? null;
+}
+
+function flowFull(frame: FlowStatusFrameV2, useAscii: boolean): string {
+    const facts: string[] = [];
+    if (frame.blockingAttention > 0)
+        facts.push(`${useAscii ? '!' : '⚠'} Input${frame.blockingAttention > 1 ? ` ${frame.blockingAttention}` : ''}`);
+    facts.push(`Flow ${frame.orientation.index}/9 · ${frame.orientation.label}`);
+    const measure = frame.orientation.measure;
+    if (measure)
+        facts.push(`${measure.label} ${measure.current}/${measure.total} ${bar(measure.current, measure.total, useAscii)}`);
+    const detail = phaseDetail(frame, false);
+    if (detail)
+        facts.push(detail);
+    const motion = movement(frame);
+    if (motion)
+        facts.push(motion);
+    return facts.join(' │ ');
+}
+
+function flowCompact(frame: FlowStatusFrameV2): string {
+    const facts: string[] = [];
+    if (frame.blockingAttention > 0)
+        facts.push(`! Input${frame.blockingAttention > 1 ? ` ${frame.blockingAttention}` : ''}`);
+    facts.push(`Flow ${frame.orientation.index}/9 ${frame.orientation.label}`);
+    const measure = frame.orientation.measure;
+    if (measure)
+        facts.push(`${measure.label} ${measure.current}/${measure.total}`);
+    const detail = phaseDetail(frame, true);
+    if (detail)
+        facts.push(detail);
+    const motion = movement(frame);
+    if (motion)
+        facts.push(motion);
+    return facts.join(' | ');
+}
+
+function flow(
+    result: FlowStatusResultV2,
+    terminalWidth: number,
+    useAscii: boolean
+): string | null {
+    if (result.state === 'unavailable')
+        return null;
+    const minimum = `Flow ${result.orientation.index}/9 ${result.orientation.label}`;
+    if (terminalWidth <= getVisibleWidth(minimum))
+        return terminalWidth < 10 ? null : cropEnd(minimum, terminalWidth);
+    const full = flowFull(result, useAscii);
+    if (getVisibleWidth(full) <= terminalWidth)
+        return full;
+    const compact = flowCompact(result);
+    if (getVisibleWidth(compact) <= terminalWidth)
+        return compact;
+    // Preserve blocking attention, orientation, then the same labelled denominator.
+    const facts: string[] = [];
+    if (result.blockingAttention > 0)
+        facts.push('! Input');
+    facts.push(minimum);
+    const measure = result.orientation.measure;
+    if (measure)
+        facts.push(`${measure.label} ${measure.current}/${measure.total}`);
+    while (facts.length > 1 && getVisibleWidth(facts.join(' | ')) > terminalWidth)
+        facts.pop();
+    const output = facts.join(' | ');
+    return getVisibleWidth(output) <= terminalWidth ? output : cropEnd(minimum, terminalWidth);
+}
+
+export class FlowStatusWidget implements Widget {
+    private readonly provider: Pick<FlowStatusProvider, 'read'>;
+
+    constructor(provider: Pick<FlowStatusProvider, 'read'> = new FlowStatusProvider()) {
+        this.provider = provider;
+    }
+
+    getDefaultColor(): string { return 'cyan'; }
+    getDescription(): string { return 'Displays explicit root Task and reversible Flow status'; }
+    getDisplayName(): string { return 'Flow Status'; }
+    getCategory(): string { return 'Progress'; }
+
+    getEditorDisplay(item: WidgetItem): WidgetEditorDisplay {
+        return {
+            displayText: this.getDisplayName(),
+            modifierText: `(${view(item) ?? 'invalid'} view)`
+        };
+    }
+
+    render(item: WidgetItem, context: RenderContext, _settings: Settings): string | null {
+        const selectedView = view(item);
+        if (!selectedView)
+            return null;
+        if (context.isPreview)
+            return selectedView === 'root-task'
+                ? 'Task · 07-30-omp-flow-tui-control · TUI control'
+                : 'Flow 6/9 · Execute │ Work 4/13 ████░░░░░░░░░ │ Review · Round 2';
+        const result = this.provider.read(context.data);
+        const width = Math.max(0, context.terminalWidth ?? 80);
+        return selectedView === 'root-task'
+            ? rootTask(result, width)
+            : flow(result, width, ascii(context));
+    }
+
+    supportsRawValue(): boolean { return false; }
+    supportsColors(_item: WidgetItem): boolean { return true; }
+}
