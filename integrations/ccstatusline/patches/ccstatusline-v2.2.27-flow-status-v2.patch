+import { createHash } from 'crypto';
+import {
+    mkdirSync,
+    mkdtempSync,
+    rmSync,
+    writeFileSync
+} from 'fs';
+import { tmpdir } from 'os';
+import {
+    join,
+    resolve
+} from 'path';
+import {
+    afterEach,
+    describe,
+    expect,
+    it
+} from 'vitest';
+
+import { FlowStatusProvider } from '../FlowStatusProvider';
+
+const roots: string[] = [];
+
+function scopeRoot(): string {
+    const root = resolve(mkdtempSync(join(tmpdir(), 'ccstatusline-flow-status-v2-')));
+    roots.push(root);
+    mkdirSync(join(root, '.omp-flow', '.runtime', 'flow-status'), { recursive: true });
+    return root;
+}
+
+function key(root: string, session: string): string {
+    return createHash('sha256').update(JSON.stringify([root, 'claude', session]), 'utf8').digest('hex');
+}
+
+function writeSnapshot(root: string, session: string, now: number, overrides: Record<string, unknown> = {}): void {
+    const publication = {
+        version: 2,
+        capability: 'orchestratorFlowPublicationV2',
+        requestId: 'request-revision-0001',
+        requestDigest: '0'.repeat(64),
+        scope: { repositoryRoot: root, host: 'claude', hostSessionId: session },
+        rootTask: {
+            taskId: '07-30-omp-flow-tui-control',
+            title: '状态栏返工',
+            selectionRevision: 'selection-revision-0001'
+        },
+        orientation: {
+            position: 'execute',
+            movement: 'forward',
+            fromPosition: 'qbd-2',
+            resumeFrom: null,
+            detail: {
+                kind: 'execute',
+                workSetRevision: 'work-set-revision-0001',
+                workTotal: 13,
+                workCatalogRevision: 'catalog-revision-0001',
+                workCatalogDigest: '1'.repeat(64),
+                acceptedWork: 4,
+                acceptanceSetRevision: 'acceptance-revision-0001',
+                acceptanceDigest: '2'.repeat(64),
+                currentWork: {
+                    workId: 'claude-hook',
+                    title: 'Claude Hook',
+                    workRevision: 'work-revision-0001',
+                    focus: 'review',
+                    reviewRound: 2,
+                    reworkRound: 1,
+                    reviewVerdict: 'pending',
+                    handoffRevision: 'handoff-revision-0001'
+                }
+            },
+            measure: {
+                owner: 'accepted-work',
+                label: 'Work',
+                current: 4,
+                total: 13,
+                unit: 'accepted',
+                unitSetRevision: 'work-set-revision-0001',
+                sourceRevision: 'acceptance-revision-0001'
+            }
+        },
+        drilldown: { wave: null },
+        publisher: {
+            publisherId: 'main-publisher',
+            actorId: 'main-actor',
+            sourceRevision: 'source-revision-0001',
+            publicationRevision: 'publication-revision-0001'
+        },
+        semanticObservedAtUnixMs: now,
+        lease: {
+            leaseId: 'lease-identifier-0001',
+            leaseRevision: 'lease-revision-0001',
+            ownerActorId: 'main-actor',
+            selectionRevision: 'selection-revision-0001',
+            issuedAtUnixMs: now,
+            expiresAtUnixMs: now + 900_000,
+            durationMs: 900_000
+        }
+    };
+    const snapshot = {
+        version: 2,
+        snapshotRevision: 'snapshot-revision-0001',
+        generatedAtUnixMs: now,
+        scope: { repositoryRoot: root, host: 'claude', hostSessionId: session },
+        rootFlow: { state: 'available', publication },
+        nativeActivity: {
+            version: 1,
+            attention: [{ severity: 'blocking', count: 1 }]
+        },
+        ...overrides
+    };
+    writeFileSync(
+        join(root, '.omp-flow', '.runtime', 'flow-status', `${key(root, session)}.json`),
+        JSON.stringify({ version: 2, cachedAtUnixMs: now, snapshot }),
+        'utf8'
+    );
+}
+
+afterEach(() => {
+    for (const root of roots.splice(0))
+        rmSync(root, { recursive: true, force: true });
+});
+
+describe('FlowStatusProvider v2', () => {
+    it('reads one exact root Task/Flow projection and keeps native activity separate', () => {
+        const now = 1_900_000_000_000;
+        const root = scopeRoot();
+        writeSnapshot(root, 'session-a', now);
+        const result = new FlowStatusProvider().read({ session_id: 'session-a', cwd: root }, now + 1000);
+        expect(result.state).toBe('available');
+        if (result.state === 'available') {
+            expect(result.rootTask).toEqual({
+                taskId: '07-30-omp-flow-tui-control',
+                title: '状态栏返工'
+            });
+            expect(result.orientation).toMatchObject({
+                index: 6,
+                label: 'Execute',
+                movement: 'forward',
+                measure: { label: 'Work', current: 4, total: 13 }
+            });
+            expect(result.blockingAttention).toBe(1);
+        }
+    });
+
+    it('expires only root authority by its publisher lease', () => {
+        const now = 1_900_000_000_000;
+        const root = scopeRoot();
+        writeSnapshot(root, 'session-a', now);
+        expect(new FlowStatusProvider().read(
+            { session_id: 'session-a', cwd: root },
+            now + 900_001
+        )).toEqual({ state: 'unavailable', reason: 'expired' });
+    });
+
+    it('never scans another session and rejects old v1 envelopes', () => {
+        const now = 1_900_000_000_000;
+        const root = scopeRoot();
+        writeSnapshot(root, 'session-a', now);
+        expect(new FlowStatusProvider().read({
+            session_id: 'other-session',
+            cwd: root
+        }, now)).toEqual({ state: 'unavailable', reason: 'missing' });
+        writeFileSync(
+            join(root, '.omp-flow', '.runtime', 'flow-status', `${key(root, 'old')}.json`),
+            JSON.stringify({ version: 1, cachedAtUnixMs: now, snapshot: { version: 1 } }),
+            'utf8'
+        );
+        expect(new FlowStatusProvider().read({
+            session_id: 'old',
+            cwd: root
+        }, now)).toEqual({ state: 'unavailable', reason: 'malformed' });
+    });
+});
