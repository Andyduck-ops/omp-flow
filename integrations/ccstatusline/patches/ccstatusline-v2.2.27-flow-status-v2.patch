diff --git a/src/providers/FlowStatusProvider.ts b/src/providers/FlowStatusProvider.ts
new file mode 100644
index 0000000..660e633
--- /dev/null
+++ b/src/providers/FlowStatusProvider.ts
@@ -0,0 +1,298 @@
+import { createHash } from 'crypto';
+import {
+    readFileSync,
+    statSync
+} from 'fs';
+import {
+    join,
+    resolve
+} from 'path';
+
+import type { StatusJSON } from '../types/StatusJSON';
+
+const MAX_CACHE_BYTES = 64 * 1024 + 4096;
+const MAX_CACHE_AGE_MS = 24 * 60 * 60 * 1000;
+const FUTURE_TOLERANCE_MS = 2000;
+const POSITIONS = [
+    'explore',
+    'design',
+    'qbd-1',
+    'decompose',
+    'qbd-2',
+    'execute',
+    'integrate',
+    'wiki',
+    'finish'
+] as const;
+
+type UnknownRecord = Record<string, unknown>;
+
+export interface FlowStatusMeasureV2 {
+    owner: string;
+    label: string;
+    current: number;
+    total: number;
+    unit: string;
+}
+
+export interface FlowStatusCurrentWorkV2 {
+    workId: string;
+    title: string | null;
+    focus: 'implement' | 'review' | 'rework' | 'accepted';
+    reviewRound: number;
+    reworkRound: number;
+    reviewVerdict: 'none' | 'pending' | 'changes-requested' | 'accepted';
+}
+
+export interface FlowStatusFrameV2 {
+    state: 'available';
+    freshness: 'fresh';
+    ageMs: number;
+    snapshotRevision: string;
+    rootTask: {
+        taskId: string;
+        title: string | null;
+    };
+    orientation: {
+        index: number;
+        position: typeof POSITIONS[number];
+        label: string;
+        movement: 'initial' | 'same' | 'forward' | 'backtrack' | 'resume' | 'reopen';
+        measure: FlowStatusMeasureV2 | null;
+        detail: UnknownRecord;
+    };
+    blockingAttention: number;
+}
+
+export interface FlowStatusUnavailableV2 {
+    state: 'unavailable';
+    reason:
+        | 'missing-scope'
+        | 'missing'
+        | 'expired'
+        | 'unsupported'
+        | 'malformed'
+        | 'scope-mismatch'
+        | 'selection-mismatch'
+        | 'session-replaced'
+        | 'disconnected'
+        | 'cleared';
+}
+
+export type FlowStatusResultV2 = FlowStatusFrameV2 | FlowStatusUnavailableV2;
+
+function record(value: unknown): UnknownRecord | null {
+    return value !== null && typeof value === 'object' && !Array.isArray(value)
+        ? value as UnknownRecord
+        : null;
+}
+
+function safeInteger(value: unknown, minimum = 0, maximum = Number.MAX_SAFE_INTEGER): value is number {
+    return Number.isSafeInteger(value) && Number(value) >= minimum && Number(value) <= maximum;
+}
+
+function text(value: unknown, maximum = 512): value is string {
+    return typeof value === 'string' && value.length > 0 && value.length <= maximum;
+}
+
+function cacheKey(repositoryRoot: string, sessionId: string): string {
+    return createHash('sha256')
+        .update(JSON.stringify([repositoryRoot, 'claude', sessionId]), 'utf8')
+        .digest('hex');
+}
+
+function unavailable(reason: FlowStatusUnavailableV2['reason']): FlowStatusUnavailableV2 {
+    return { state: 'unavailable', reason };
+}
+
+function reason(value: unknown): FlowStatusUnavailableV2['reason'] {
+    if (
+        value === 'expired'
+        || value === 'unsupported'
+        || value === 'malformed'
+        || value === 'scope-mismatch'
+        || value === 'selection-mismatch'
+        || value === 'session-replaced'
+        || value === 'disconnected'
+        || value === 'cleared'
+    )
+        return value;
+    return 'malformed';
+}
+
+function label(position: typeof POSITIONS[number]): string {
+    const labels: Record<typeof position, string> = {
+        'explore': 'Explore',
+        'design': 'Design',
+        'qbd-1': 'QbD 1',
+        'decompose': 'Decompose',
+        'qbd-2': 'QbD 2',
+        'execute': 'Execute',
+        'integrate': 'Integrate',
+        'wiki': 'Wiki',
+        'finish': 'Finish'
+    };
+    return labels[position];
+}
+
+function parseMeasure(value: unknown): FlowStatusMeasureV2 | null | false {
+    if (value === null)
+        return null;
+    const measure = record(value);
+    if (
+        !measure
+        || !text(measure.owner, 64)
+        || !text(measure.label, 64)
+        || !safeInteger(measure.total, 1, 64)
+        || !safeInteger(measure.current, 0, measure.total)
+        || !text(measure.unit, 48)
+    )
+        return false;
+    return {
+        owner: measure.owner,
+        label: measure.label,
+        current: measure.current,
+        total: measure.total,
+        unit: measure.unit
+    };
+}
+
+function blockingAttention(nativeActivity: unknown): number {
+    const native = record(nativeActivity);
+    if (native?.version !== 1 || !Array.isArray(native.attention))
+        return 0;
+    let count = 0;
+    for (const raw of native.attention) {
+        const item = record(raw);
+        if (item?.severity === 'blocking' && safeInteger(item.count, 1, 1_000_000))
+            count += item.count;
+    }
+    return count;
+}
+
+function parseSnapshot(
+    snapshotValue: unknown,
+    repositoryRoot: string,
+    sessionId: string,
+    nowMs: number
+): FlowStatusResultV2 {
+    const snapshot = record(snapshotValue);
+    const scope = record(snapshot?.scope);
+    if (
+        snapshot?.version !== 2
+        || !text(snapshot.snapshotRevision, 128)
+        || !safeInteger(snapshot.generatedAtUnixMs)
+        || scope?.repositoryRoot !== repositoryRoot
+        || scope.host !== 'claude'
+        || scope.hostSessionId !== sessionId
+    )
+        return unavailable('scope-mismatch');
+    const root = record(snapshot.rootFlow);
+    if (!root)
+        return unavailable('malformed');
+    if (root.state === 'unavailable')
+        return unavailable(reason(root.reason));
+    const publication = record(root.publication);
+    const publicationScope = record(publication?.scope);
+    const rootTask = record(publication?.rootTask);
+    const orientation = record(publication?.orientation);
+    const publisher = record(publication?.publisher);
+    const lease = record(publication?.lease);
+    if (
+        root.state !== 'available'
+        || publication?.version !== 2
+        || publication.capability !== 'orchestratorFlowPublicationV2'
+        || publicationScope?.repositoryRoot !== repositoryRoot
+        || publicationScope.host !== 'claude'
+        || publicationScope.hostSessionId !== sessionId
+        || !rootTask
+        || !text(rootTask.taskId, 128)
+        || (rootTask.title !== null && !text(rootTask.title, 512))
+        || !orientation
+        || !POSITIONS.includes(orientation.position as typeof POSITIONS[number])
+        || !['initial', 'same', 'forward', 'backtrack', 'resume', 'reopen'].includes(String(orientation.movement))
+        || !record(orientation.detail)
+        || record(orientation.detail)?.kind !== orientation.position
+        || !publisher
+        || !text(publisher.publicationRevision, 128)
+        || !lease
+        || !safeInteger(lease.expiresAtUnixMs)
+    )
+        return unavailable('malformed');
+    if (lease.expiresAtUnixMs <= nowMs)
+        return unavailable('expired');
+    const measure = parseMeasure(orientation.measure);
+    if (measure === false)
+        return unavailable('malformed');
+    const position = orientation.position as typeof POSITIONS[number];
+    return {
+        state: 'available',
+        freshness: 'fresh',
+        ageMs: Math.max(0, nowMs - snapshot.generatedAtUnixMs),
+        snapshotRevision: snapshot.snapshotRevision,
+        rootTask: {
+            taskId: rootTask.taskId,
+            title: rootTask.title
+        },
+        orientation: {
+            index: POSITIONS.indexOf(position) + 1,
+            position,
+            label: label(position),
+            movement: orientation.movement as FlowStatusFrameV2['orientation']['movement'],
+            measure,
+            detail: orientation.detail as UnknownRecord
+        },
+        blockingAttention: blockingAttention(snapshot.nativeActivity)
+    };
+}
+
+/**
+ * One provider instance is registered for the widget kind. ccstatusline passes the same
+ * StatusJSON object while pre-rendering one frame, so this WeakMap makes the root-task and flow
+ * views share exactly one cache open/read/validation.
+ */
+export class FlowStatusProvider {
+    private readonly frame = new WeakMap<StatusJSON, { nowMs: number; result: FlowStatusResultV2 }>();
+
+    read(data: StatusJSON | undefined, nowMs = Date.now()): FlowStatusResultV2 {
+        if (!data)
+            return unavailable('missing-scope');
+        const cached = this.frame.get(data);
+        if (cached)
+            return cached.result;
+        const result = this.readOnce(data, nowMs);
+        this.frame.set(data, { nowMs, result });
+        return result;
+    }
+
+    private readOnce(data: StatusJSON, nowMs: number): FlowStatusResultV2 {
+        const sessionId = data.session_id;
+        const workspace = data.workspace?.project_dir ?? data.workspace?.current_dir ?? data.cwd;
+        if (!sessionId || !workspace)
+            return unavailable('missing-scope');
+        const repositoryRoot = resolve(workspace);
+        const path = join(
+            repositoryRoot,
+            '.omp-flow',
+            '.runtime',
+            'flow-status',
+            `${cacheKey(repositoryRoot, sessionId)}.json`
+        );
+        try {
+            const metadata = statSync(path);
+            if (!metadata.isFile() || metadata.size > MAX_CACHE_BYTES)
+                return unavailable('malformed');
+            const entry = record(JSON.parse(readFileSync(path, 'utf8')));
+            if (
+                entry?.version !== 2
+                || !safeInteger(entry.cachedAtUnixMs)
+                || nowMs - entry.cachedAtUnixMs > MAX_CACHE_AGE_MS
+                || entry.cachedAtUnixMs - nowMs > FUTURE_TOLERANCE_MS
+            )
+                return unavailable('malformed');
+            return parseSnapshot(entry.snapshot, repositoryRoot, sessionId, nowMs);
+        } catch (error) {
+            return unavailable((error as NodeJS.ErrnoException).code === 'ENOENT' ? 'missing' : 'malformed');
+        }
+    }
+}
